<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HubLink.Desktop.ViewModels"
        x:Class="HubLink.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HubLink - Shipment Tracker"
        Width="1000" Height="650" MinWidth="800" MinHeight="500">

  <Grid RowDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Classes="appTitle" Text="HubLink - Shipment Tracker" />
    <StackPanel Grid.Row="1" Margin="16" Spacing="6">
      <TextBlock Text="{Binding Status}" />
      <TextBlock Text="{Binding Branch, StringFormat='Branch: {0}'}" />
      <TextBlock Text="{Binding Endpoint, StringFormat='Request URL: {0}'}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
